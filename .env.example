# Copy the Transaction pooler URI from Supabase → Connect.
# Do NOT use db.<project-ref>.supabase.co — that host is IPv6-only and Vercel cannot reach it.
#
# Example:
# postgresql://postgres.YOUR_REF:[PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?sslmode=require
#
# If you attached Supabase from the Vercel dashboard, POSTGRES_URL is set automatically.
DATABASE_URL=
POSTGRES_URL=

# Optional. Used to sign login cookies. Set this in production.
SESSION_SECRET=
